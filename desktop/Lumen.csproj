<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <Product>Lumen Studio</Product>
    <Company>Lumen Studio</Company>
    <Description>Lumen Studio – lokaler KI-Bildgenerator</Description>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../app/VERSION').Trim())</Version>
    <ApplicationIcon>../app/icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <EngineDatei Include="../app/**/*" Exclude="../app/**/__pycache__/**;../app/**/*.pyc" />
    <EmbeddedResource Include="einrichtung.html" LogicalName="einrichtung.html" />
    <EmbeddedResource Include="$(IntermediateOutputPath)engine.zip" LogicalName="engine.zip" />
  </ItemGroup>
  <Target Name="EnginePacken" BeforeTargets="BeforeBuild">
    <RemoveDir Directories="$(IntermediateOutputPath)engine" />
    <Copy SourceFiles="@(EngineDatei)" DestinationFiles="@(EngineDatei->'$(IntermediateOutputPath)engine/%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)engine" DestinationFile="$(IntermediateOutputPath)engine.zip" Overwrite="true" />
  </Target>
</Project>
